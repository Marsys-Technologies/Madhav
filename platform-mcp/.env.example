# platform-mcp — required environment variables
#
# Copy this file to .env.local for local development.
# In production (Cloud Run), set these via --set-env-vars or Secret Manager.

# URL of the amjis-web Cloud Run service (the MARSYS platform).
# Example: https://amjis-web-<hash>-el.a.run.app
# Required in production; in local dev, you can point to http://localhost:3000
PLATFORM_URL=https://amjis-web-<hash>-el.a.run.app

# Service account email for amjis-mcp (used to fetch identity tokens for
# service-to-service auth to the platform). Only needed in production.
# In local dev, set SERVICE_TOKEN instead (see below).
MCP_SERVICE_ACCOUNT_EMAIL=amjis-mcp@<project-id>.iam.gserviceaccount.com

# Port for the MCP HTTP server. Default: 8080.
MCP_PORT=8080

# Shared secret used as the X-MCP-Internal-Token header for service-to-service
# auth from platform-mcp → platform /api/mcp/execute.
# Must match the MCP_INTERNAL_TOKEN env var on the amjis-web Cloud Run service.
MCP_INTERNAL_TOKEN=<generate-a-strong-random-secret>

# LOCAL DEV ONLY: override the identity token with a static value.
# In production, the identity token is fetched from the GCP metadata server.
# SERVICE_TOKEN=<oidc-token-for-local-testing>
