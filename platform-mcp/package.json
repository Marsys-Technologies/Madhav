{
  "name": "platform-mcp",
  "version": "1.0.0",
  "description": "MARSYS-JIS MCP Server — HTTP/SSE adapter over the MARSYS platform",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "accuracy:capture": "vitest run test/accuracy/run.test.ts --reporter=verbose",
    "accuracy:diff": "tsx test/accuracy/diff.ts",
    "accuracy:regenerate-golden": "tsx test/accuracy/regenerate_golden.ts",
    "bench:capture": "vitest run test/bench/run.ts --reporter=verbose",
    "bench:diff": "tsx test/bench/diff.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.19.2",
    "google-auth-library": "^9.11.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
