{
  "displayName": "SLO burn-rate — error rate (multi-window)",
  "documentation": {
    "content": "Alerts on fast-burn (1h, 14.4x budget) and slow-burn (6h, 6x budget) error-budget consumption on the amjis-web error-rate SLO. See infra/monitoring/slos/error_rate.json.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "Fast burn (1h window, 14.4x)",
      "conditionThreshold": {
        "filter": "select_slo_burn_rate(\"projects/${PROJECT_ID}/services/amjis-web/serviceLevelObjectives/error-rate\", \"3600s\")",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 14.4,
        "duration": "0s",
        "trigger": { "count": 1 }
      }
    },
    {
      "displayName": "Slow burn (6h window, 6x)",
      "conditionThreshold": {
        "filter": "select_slo_burn_rate(\"projects/${PROJECT_ID}/services/amjis-web/serviceLevelObjectives/error-rate\", \"21600s\")",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 6,
        "duration": "0s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": ["${ALERT_NOTIFICATION_CHANNEL_ID}"],
  "alertStrategy": { "autoClose": "604800s" }
}
