FROM python:3.11-slim

ARG PIPELINE_VERSION=dev
LABEL org.opencontainers.image.title="marsys-pipeline"
LABEL org.opencontainers.image.description="MARSYS-JIS RAG build pipeline (Phase 14B)"
LABEL marsys.pipeline.version="${PIPELINE_VERSION}"

WORKDIR /app

RUN apt-get update && apt-get install -y gcc g++ libpq-dev curl && rm -rf /var/lib/apt/lists/*

# Swiss Ephemeris data files — bundled from GCS. Fail the build if any file is missing
# or zero-byte (do NOT '|| true' — a broken ephemeris ships a silently-wrong engine).
RUN set -euo pipefail; \
    mkdir -p /app/ephe; \
    for f in sepl_18.se1 semo_18.se1 seas_18.se1 sefstars.txt seleapsec.txt; do \
      curl -fSL -o "/app/ephe/$f" "https://storage.googleapis.com/madhav-ephemeris/se1/$f"; \
      test -s "/app/ephe/$f" || { echo "FATAL: /app/ephe/$f missing or empty"; exit 1; }; \
    done
ENV SWE_EPHE_PATH=/app/ephe

COPY platform/python-sidecar/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY platform/python-sidecar/pipeline/ ./platform/python-sidecar/pipeline/
# Brahma layer writers (L0-L5)
COPY platform/python-sidecar/brahmagyan/ ./platform/python-sidecar/brahmagyan/
# Stream G: PyJHora adapter (pyjhora_adapter package)
COPY platform/python-sidecar/pyjhora_adapter/ ./platform/python-sidecar/pyjhora_adapter/
# L1 Gaṇita writers (ga_*). Required so the orchestrator (driven by --run-id) can
# import + dispatch the registered GA WriterBase subclasses. Without this COPY,
# `python -m ga_writers.*` and registered-writer discovery ModuleNotFoundError in
# the deployed job image (Orchestrator Convergence Phase 1, 2026-06-12).
# ga_writers' only non-stdlib import is pyjhora_adapter (COPYed above); psycopg
# comes from requirements.txt.
COPY platform/python-sidecar/ga_writers/ ./platform/python-sidecar/ga_writers/
COPY platform/python-sidecar/bodha_writers/ ./platform/python-sidecar/bodha_writers/
# L3 + L4 service-engine modules (ka_* and ph_* writers import `from services.<asset>.engine`).
# services/ is NOT in the pipeline/ tree, so it needs its own COPY.
# Without this line, Cloud Run job → ModuleNotFoundError → silent IN_PROGRESS hang.
# See L4_PHALA_ORCHESTRATOR_READINESS_v1_0.md §2 (the one real latent infra gap).
COPY platform/python-sidecar/services/ ./platform/python-sidecar/services/
# Panchang engine (ga_panchanga + ga_pyjhora_engine health probe). Required since
# ga_panchanga_writer imports panchang_engine at build time.
COPY platform/python-sidecar/panchang_engine/ ./platform/python-sidecar/panchang_engine/
# CGM edge manifests (read by brahmagyan.bodha.bo22 at runtime)
COPY 035_DISCOVERY_LAYER/cgm_edges_manifest_v1_0.json 035_DISCOVERY_LAYER/
COPY 035_DISCOVERY_LAYER/cgm_supports_edges_manifest_v1_0.json 035_DISCOVERY_LAYER/
COPY 035_DISCOVERY_LAYER/cgm_contradicts_edges_manifest_v1_0.json 035_DISCOVERY_LAYER/

ENV PYTHONPATH=/app/platform/python-sidecar
ENV PYTHONUNBUFFERED=1
# Stream G: Swiss Ephemeris path for PyJHora
ENV SWE_EPHE_PATH=/app/ephe
RUN mkdir -p /app/ephe

# Brahma orchestrator — accepts --run-id, drives build_runs plan
ENTRYPOINT ["python", "-m", "pipeline.orchestrator.main"]
CMD ["--help"]
