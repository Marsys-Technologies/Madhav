# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# pariprashna dd1 battery run artifacts (receipts, transcripts — local only)
/scripts/pariprashna/dd1_battery/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
verification/

# CI-staged governance files (copied from repo root during docker build; not committed)
/00_ARCHITECTURE/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
storageState.json

# Timestamped probe / smoke run outputs — local artifacts, not source of truth.
# Representative baselines are committed under fixed-name files
# (scripts/eval/*_BASELINE_*.json). Pattern added 2026-05-17 after da140c8.
scripts/eval/sla_probe_planner_blind_tools_*Z.json
scripts/eval/planner_blind_fix_smoke_*Z.json
venv/
/.repro-scratch/
