  "estimated_seconds": 1,
  "volume_explanation": "An anomaly registry, not a product: FEWER rows is better, so this asset has a CEILING and deliberately NO target_floor -- a floor would reward fabricating findings (\u00a7N.4). Five per-anchor detectors plus one chart-wide detector bound it. Detector is chart-PARTITIONED per D-CND-03.",
  "english_description": "Anomaly registry: 5 deterministic detectors (confidence inflation, magnitude drift, falsifier absent, ledger gap, layer leakage). LEAKAGE-FIREWALL halts build on L5 calibration contamination. auto_action=stage_for_review only.",
  "integrity_check_sql": "\n-- D-CND-03: chart-partitioned.\nSELECT\n  -- Earned signal: an l5_calibration_attempted row can only exist if the build-halt failed.\n  NOT EXISTS (SELECT 1 FROM phala_sodhana WHERE leakage_class = 'l5_calibration_attempted'\n     GROUP BY chart_id HAVING count(*) > 0)\n  -- The anchor_id FK omits chart_id, so a row could legally cite another chart's anchor.\n  AND NOT EXISTS (SELECT 1 FROM phala_sodhana s\n      LEFT JOIN phala_anchors a ON a.anchor_id = s.anchor_id\n     WHERE a.anchor_id IS NULL OR a.chart_id <> s.chart_id\n     GROUP BY s.chart_id HAVING count(*) > 0)\n",
  "natural_key_partition": "phala_sodhana (anchor_id, anomaly_type, detected_field) -- sole writer; (anchor_id, anomaly_type, detected_field) is the table's own UNIQUE constraint (phala_sodhana_natural_key). chart_id is not part of this unique index but anchor_id is FK'd to phala_anchors(anchor_id), which is itself chart-scoped, so the triple is chart-unambiguous in practice; chart_id is still carried in where_equals and value_columns per this series' convention. Writer does an unconditional DELETE FROM phala_sodhana WHERE chart_id = %s immediately before the INSERT loop (delete-then-insert-per-chart, CLAUDE.md SS N.3), with a belt-and-suspenders ON CONFLICT DO NOTHING against the natural-key unique index on the INSERT itself; computed_at (DEFAULT now()) excluded from the digest value columns as non-deterministic across rebuilds",
  "rebuild_on_probe_fail": false,
  "expected_volume_inputs": {
   "anchor_count": "SELECT count(*) FROM phala_anchors WHERE chart_id = $1",
   "chart_wide_detectors": 1,
   "per_anchor_detectors": 5
  },
  "writer_timeout_seconds": 10800,
  "expected_volume_formula": "rows BETWEEN 0 AND (5 * anchor_count) + 1"
 },
