 "constraints": [
  {
   "conname": "phala_anchors_anchor_source_check",
   "contype": "c",
   "def": "CHECK ((anchor_source = ANY (ARRAY['convergence'::text, 'discovery'::text, 'bhavishya'::text, 'subsystem'::text])))"
  },
  {
   "conname": "phala_anchors_ayanamsha_robustness_check",
   "contype": "c",
   "def": "CHECK (((ayanamsha_robustness >= 0) AND (ayanamsha_robustness <= 5)))"
  },
  {
   "conname": "phala_anchors_confidence_high_check",
   "contype": "c",
   "def": "CHECK (((confidence_high >= (0.0)::double precision) AND (confidence_high <= (0.80)::double precision)))"
  },
  {
   "conname": "phala_anchors_confidence_low_check",
   "contype": "c",
   "def": "CHECK (((confidence_low >= (0.0)::double precision) AND (confidence_low <= (0.80)::double precision)))"
  },
  {
   "conname": "phala_anchors_direction_check",
   "contype": "c",
   "def": "CHECK ((direction = ANY (ARRAY['elevated'::text, 'suppressed'::text, 'mixed'::text])))"
  },
  {
   "conname": "phala_anchors_domain_canonical",
   "contype": "c",
   "def": "CHECK ((domain = ANY (ARRAY['career'::text, 'wealth'::text, 'relationship'::text, 'progeny'::text, 'health'::text, 'education'::text, 'family'::text, 'residence'::text, 'travel'::text, 'spirituality'::text, 'character'::text, 'transition'::text, 'general'::text])))"
  },
  {
   "conname": "phala_anchors_horizon_tier_check",
   "contype": "c",
   "def": "CHECK ((horizon_tier = ANY (ARRAY['near'::text, 'lifetime'::text])))"
  },
  {
   "conname": "phala_anchors_magnitude_check",
   "contype": "c",
   "def": "CHECK ((magnitude = ANY (ARRAY['minor'::text, 'moderate'::text, 'major'::text, 'pivotal'::text])))"
  },
  {
   "conname": "phala_anchors_malleability_check",
   "contype": "c",
   "def": "CHECK ((malleability = ANY (ARRAY['fated'::text, 'semi_influenceable'::text, 'influenceable'::text])))"
  },
  {
   "conname": "phala_anchors_posterior_check",
   "contype": "c",
   "def": "CHECK (((posterior >= (0.0)::double precision) AND (posterior <= (1.0)::double precision)))"
  },
  {
   "conname": "phala_anchors_subsystem_source_check",
   "contype": "c",
   "def": "CHECK ((subsystem_source = ANY (ARRAY['medical'::text, 'vastu'::text, 'nakshatra'::text, 'yoga'::text, 'sade_sati'::text, 'tajaka'::text])))"
  },
  {
   "conname": "phala_anchors_bhavishya_id_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (bhavishya_id) REFERENCES kala_bhavishya(id) ON DELETE SET NULL"
  },
  {
   "conname": "phala_anchors_convergence_id_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (convergence_id) REFERENCES kala_convergence(convergence_id) ON DELETE CASCADE"
  },
  {
   "conname": "phala_anchors_pkey",
   "contype": "p",
   "def": "PRIMARY KEY (anchor_id)"
  }
 ],
