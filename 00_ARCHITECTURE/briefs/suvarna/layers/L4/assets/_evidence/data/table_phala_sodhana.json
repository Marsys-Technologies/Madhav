 "constraints": [
  {
   "conname": "phala_sodhana_anomaly_severity_check",
   "contype": "c",
   "def": "CHECK ((anomaly_severity = ANY (ARRAY['critical'::text, 'major'::text, 'minor'::text, 'informational'::text])))"
  },
  {
   "conname": "phala_sodhana_anomaly_type_check",
   "contype": "c",
   "def": "CHECK ((anomaly_type = ANY (ARRAY['confidence_inflation'::text, 'magnitude_drift'::text, 'falsifier_absent'::text, 'ledger_gap'::text, 'layer_leakage'::text, 'confidence_degenerate'::text, 'ceiling_inputs_degenerate'::text])))"
  },
  {
   "conname": "phala_sodhana_auto_action_check",
   "contype": "c",
   "def": "CHECK ((auto_action = 'stage_for_review'::text))"
  },
  {
   "conname": "phala_sodhana_leakage_class_check",
   "contype": "c",
   "def": "CHECK ((leakage_class = ANY (ARRAY['interpretation_in_fact_field'::text, 'l5_calibration_attempted'::text, 'l2_contamination'::text])))"
  },
  {
   "conname": "phala_sodhana_anchor_id_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (anchor_id) REFERENCES phala_anchors(anchor_id) ON DELETE CASCADE"
  },
  {
   "conname": "phala_sodhana_pkey",
   "contype": "p",
   "def": "PRIMARY KEY (sodhana_id)"
  }
 ],
