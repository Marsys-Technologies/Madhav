  }
 ],
 "indexes": [
  {
   "indexname": "phala_mitigation_pkey",
   "indexdef": "CREATE UNIQUE INDEX phala_mitigation_pkey ON public.phala_mitigation USING btree (mitigation_id)"
  },
  {
   "indexname": "phala_mitigation_natural_key",
   "indexdef": "CREATE UNIQUE INDEX phala_mitigation_natural_key ON public.phala_mitigation USING btree (chart_id, COALESCE(obstruction_id, ('-1'::integer)::bigint), intensity_tier)"
  },
  {
   "indexname": "phala_mitigation_chart_idx",
