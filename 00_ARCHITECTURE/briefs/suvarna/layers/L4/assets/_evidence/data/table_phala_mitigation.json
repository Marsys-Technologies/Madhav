 "constraints": [
  {
   "conname": "phala_mitigation_cross_tradition_corroboration_check",
   "contype": "c",
   "def": "CHECK (((cross_tradition_corroboration >= 0) AND (cross_tradition_corroboration <= 6)))"
  },
  {
   "conname": "phala_mitigation_intensity_tier_check",
   "contype": "c",
   "def": "CHECK ((intensity_tier = ANY (ARRAY['light'::text, 'moderate'::text, 'intensive'::text])))"
  },
  {
   "conname": "phala_mitigation_initiation_muhurta_ref_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (initiation_muhurta_ref) REFERENCES phala_muhurta(muhurta_id) ON DELETE SET NULL"
  },
  {
   "conname": "phala_mitigation_linked_anchor_id_fkey",
