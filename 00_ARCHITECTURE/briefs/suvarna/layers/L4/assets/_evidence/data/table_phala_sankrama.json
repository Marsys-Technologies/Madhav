 "constraints": [
  {
   "conname": "phala_sankrama_cascade_depth_check",
   "contype": "c",
   "def": "CHECK (((cascade_depth >= 1) AND (cascade_depth <= 3)))"
  },
  {
   "conname": "phala_sankrama_relationship_type_check",
   "contype": "c",
   "def": "CHECK ((relationship_type = ANY (ARRAY['contagion'::text, 'conflict'::text])))"
  },
  {
   "conname": "phala_sankrama_spillover_confidence_check",
   "contype": "c",
   "def": "CHECK (((spillover_confidence >= (0)::double precision) AND (spillover_confidence <= (0.80)::double precision)))"
  },
  {
   "conname": "phala_sankrama_trajectory_check",
   "contype": "c",
   "def": "CHECK ((trajectory = ANY (ARRAY['strengthening'::text, 'stable'::text, 'weakening'::text])))"
  },
  {
   "conname": "phala_sankrama_mitigation_ref_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (mitigation_ref) REFERENCES phala_mitigation(mitigation_id) ON DELETE SET NULL"
  },
  {
   "conname": "phala_sankrama_source_anchor_id_fkey",
   "contype": "f",
   "def": "FOREIGN KEY (source_anchor_id) REFERENCES phala_anchors(anchor_id) ON DELETE CASCADE"
  },
  {
   "conname": "phala_sankrama_pkey",
   "contype": "p",
   "def": "PRIMARY KEY (sankrama_id)"
  },
  {
   "conname": "phala_sankrama_natural_key",
   "contype": "u",
   "def": "UNIQUE (chart_id, source_anchor_id, cdlm_cell_id, target_domain, relationship_type)"
  }
 ],
