 "constraints": [
  {
   "conname": "phala_phaladesa_domain_canonical",
   "contype": "c",
   "def": "CHECK ((domain = ANY (ARRAY['career'::text, 'wealth'::text, 'relationship'::text, 'progeny'::text, 'health'::text, 'education'::text, 'family'::text, 'residence'::text, 'travel'::text, 'spirituality'::text, 'character'::text, 'transition'::text, 'general'::text])))"
  },
  {
   "conname": "phala_phaladesa_magnitude_check",
   "contype": "c",
   "def": "CHECK ((magnitude = ANY (ARRAY['pivotal'::text, 'major'::text, 'moderate'::text, 'minor'::text])))"
  },
  {
   "conname": "phala_phaladesa_malleability_check",
   "contype": "c",
   "def": "CHECK ((malleability = ANY (ARRAY['fated'::text, 'semi_influenceable'::text, 'influenceable'::text])))"
  },
  {
   "conname": "phala_phaladesa_narration_model_check",
   "contype": "c",
   "def": "CHECK (((narration_model IS NULL) OR (narration_model = ANY (ARRAY['gemini-pro'::text, 'gemini-ultra'::text, 'gemini-2.0-flash'::text, 'deepseek-chat'::text, 'deepseek-r1'::text]))))"
  },
  {
   "conname": "phala_phaladesa_narration_status_check",
   "contype": "c",
   "def": "CHECK ((narration_status = ANY (ARRAY['pending'::text, 'ready'::text, 'failed'::text])))"
  },
  {
   "conname": "phala_phaladesa_pramana_window_status_check",
   "contype": "c",
   "def": "CHECK ((pramana_window_status = ANY (ARRAY['pending'::text, 'open'::text, 'past_window'::text])))"
  },
  {
   "conname": "phala_phaladesa_pkey",
   "contype": "p",
   "def": "PRIMARY KEY (phaladesa_id)"
  }
 ],
 "indexes": [
  {
   "indexname": "phala_phaladesa_pkey",
   "indexdef": "CREATE UNIQUE INDEX phala_phaladesa_pkey ON public.phala_phaladesa USING btree (phaladesa_id)"
