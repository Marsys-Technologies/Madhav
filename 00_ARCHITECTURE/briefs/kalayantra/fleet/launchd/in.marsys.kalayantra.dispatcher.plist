<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- KĀLA-YANTRA v3 dispatcher (relaunch plan §6). TEMPLATE: rendered by kyctl.sh install; never loaded as-is.
     kydispatch.py is a B-1 deliverable; `kyctl.sh start dispatcher` refuses until it and an accepted
     installation receipt exist. A clean exit (STOP_dispatcher) must not respawn; a crash must.
     No credential of any kind belongs in EnvironmentVariables. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>in.marsys.kalayantra.dispatcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>-u</string>
    <string>@KY_FLEET@/kydispatch.py</string>
  </array>
  <key>WorkingDirectory</key><string>@KY_ROOT@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>@KY_ROOT@/bin:@SYSTEM_PATH@</string>
    <key>HOME</key><string>@HOME@</string>
    <key>USER</key><string>@USER@</string>
    <key>LANG</key><string>en_US.UTF-8</string>
    <key>KY_ROOT</key><string>@KY_ROOT@</string>
    <key>KY_RUN</key><string>@KY_RUN@</string>
    <key>KY_FLEET</key><string>@KY_FLEET@</string>
    <key>KY_SCRATCH</key><string>@KY_SCRATCH@</string>
    <key>CLAUDE_BIN</key><string>@CLAUDE_BIN@</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>ProcessType</key><string>Background</string>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>@KY_SCRATCH@/dispatcher/launchd.log</string>
  <key>StandardErrorPath</key><string>@KY_SCRATCH@/dispatcher/launchd.log</string>
</dict>
</plist>
