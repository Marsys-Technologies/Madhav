{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ky.action/1",
  "title": "KĀLA-YANTRA v3 action record, run/actions/<action_id>.json (relaunch plan v2.7 §4a.1, §4a.6)",
  "description": "Written by kyaction.py before a side effect (state INTENDED: inputs, target identity, intended transition) and completed with the OBSERVED result after it (DONE or FAILED). A record is never overwritten by a second begin; a FAILED attempt reopened by retry is kept in attempts[]; every reconciliation of an unfinished record against real evidence is kept in reconciliations[]. Shape only: that the result was really observed, that inputs/target identify the action, and that action_id equals the file name is not checked by this schema. Timestamps are UTC ISO-8601 ('Z' or '+00:00').",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "action_id", "kind", "actor", "inputs", "target", "intended_transition", "created_at", "state",
    "result", "completed_at"
  ],
  "properties": {
    "schema": {"const": "ky.action/1"},
    "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"},
    "kind": {"type": "string", "minLength": 1},
    "actor": {"$ref": "#/$defs/actor"},
    "inputs": {"type": "object"},
    "target": {"type": "object"},
    "intended_transition": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "#/$defs/utc"},
    "state": {"enum": ["INTENDED", "DONE", "FAILED"]},
    "result": {"type": ["object", "null"]},
    "completed_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$"
    },
    "retried_at": {"$ref": "#/$defs/utc"},
    "attempts": {
      "description": "Earlier FAILED attempts, oldest first (written by retry).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "actor", "started_at", "state", "result", "completed_at"],
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "actor": {"$ref": "#/$defs/actor"},
          "started_at": {"$ref": "#/$defs/utc"},
          "state": {"const": "FAILED"},
          "result": {"type": "object"},
          "completed_at": {"$ref": "#/$defs/utc"}
        }
      }
    },
    "reconciliations": {
      "description": "What real evidence said about an unfinished record. 'unknown' never completes it and never permits a retry; identical consecutive answers are counted, not repeated.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "outcome", "detail", "count"],
        "properties": {
          "at": {"$ref": "#/$defs/utc"},
          "outcome": {"enum": ["done", "not_done", "unknown"]},
          "detail": {"description": "The observer's evidence; any JSON value (an object when the outcome is done)."},
          "count": {"type": "integer", "minimum": 1},
          "last_at": {"$ref": "#/$defs/utc"},
          "by": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "INTENDED"}}, "required": ["state"]},
      "then": {"properties": {"result": {"type": "null"}, "completed_at": {"type": "null"}}}
    },
    {
      "if": {"properties": {"state": {"enum": ["DONE", "FAILED"]}}, "required": ["state"]},
      "then": {"properties": {"result": {"type": "object"}, "completed_at": {"type": "string"}}}
    }
  ],
  "$defs": {
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$"
    },
    "actor": {
      "description": "Who acts: the role, the kind of holder, and the holder's identity. Controller identity and provider-session identity are separate fields; at least one is present.",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "holder_kind"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "holder_kind": {"enum": ["cockpit", "controller", "supervisor"]},
        "session_id": {"type": "string", "minLength": 1},
        "controller_id": {"type": "string", "minLength": 1}
      },
      "anyOf": [{"required": ["session_id"]}, {"required": ["controller_id"]}]
    }
  }
}
