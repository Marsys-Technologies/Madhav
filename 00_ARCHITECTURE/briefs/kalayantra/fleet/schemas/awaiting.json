{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ky.awaiting/1",
  "title": "KĀLA-YANTRA v3 owner-wait, run/awaiting/<id>.json (relaunch plan v2.7 §4a.3)",
  "description": "Written by any role at a point where it would otherwise wait for the owner: the question, its options, the evidence and the deadline. The dispatcher routes it to the owner surrogate first. Shape only: class_hint is the raiser's hint, never the classification (the surrogate's charter classifies); that the id's timestamp agrees with created_at, and that the evidence paths exist, is not checked by this schema. Timestamps are UTC ISO-8601 ('Z' or '+00:00').",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "created_at", "raised_by", "item", "question", "options", "recommendation", "evidence",
    "deadline", "class_hint", "blocks"
  ],
  "properties": {
    "schema": {"const": "ky.awaiting/1"},
    "id": {
      "description": "AW-<UTC yyyymmddThhmmssZ>-<slug of lower-case letters, digits and hyphens>",
      "type": "string",
      "pattern": "^AW-[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$"
    },
    "created_at": {"$ref": "#/$defs/utc"},
    "raised_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "session_id", "job_id"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "session_id": {"type": ["string", "null"], "minLength": 1},
        "job_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "item": {"type": ["string", "null"], "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "recommendation": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "deadline": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$"
    },
    "class_hint": {"enum": ["routine", "veto", "hard_stop", "unknown"]},
    "blocks": {"enum": ["item", "loop", "none"]}
  },
  "$defs": {
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$"
    }
  }
}
