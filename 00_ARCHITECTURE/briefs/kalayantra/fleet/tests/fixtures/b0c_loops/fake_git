#!/bin/bash
# Test double for git (B-0c loop tests). Touches nothing; any invocation it does not know exits 64, so that an
# unexpected call fails loudly.
#   git -C <dir> rev-parse --is-inside-work-tree     "true" iff <dir>/.git exists, else exit 128 with git's message
#   git -C <dir> ls-remote <remote> <ref>            the lines of <dir>/.git/ls-remote.<remote> ("<sha>\t<ref>")
#                                                    whose ref is <ref>; exits with the integer in
#                                                    <dir>/.git/ls-remote.rc when that file exists (a remote that
#                                                    cannot be asked); no file for that remote = it has no refs
set -u
if [ "$#" -eq 4 ] && [ "$1" = "-C" ] && [ "$3" = "rev-parse" ] && [ "$4" = "--is-inside-work-tree" ]; then
  if [ -e "$2/.git" ]; then echo true; exit 0; fi
  echo "fatal: not a git repository (or any of the parent directories): .git" >&2
  exit 128
fi
if [ "$#" -eq 5 ] && [ "$1" = "-C" ] && [ "$3" = "ls-remote" ]; then
  printf '%s\n' "$*" >> "$2/.git/ls-remote.calls" 2>/dev/null || true
  if [ -f "$2/.git/ls-remote.rc" ]; then exit "$(cat "$2/.git/ls-remote.rc")"; fi
  if [ -f "$2/.git/ls-remote.$4" ]; then
    while IFS="$(printf '\t')" read -r sha ref; do
      if [ "$ref" = "$5" ]; then printf '%s\t%s\n' "$sha" "$ref"; fi
    done < "$2/.git/ls-remote.$4"
  fi
  exit 0
fi
echo "fake_git: unsupported invocation: $*" >&2; exit 64
