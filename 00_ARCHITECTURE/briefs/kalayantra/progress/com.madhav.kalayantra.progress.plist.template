<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.madhav.kalayantra.progress</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_EXECUTABLE__</string>
    <string>-B</string>
    <string>__PROGRESS_DIRECTORY__/server.py</string>
  </array>
  <key>WorkingDirectory</key><string>__PROGRESS_DIRECTORY__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>KY_PROGRESS_PORT</key><string>8768</string>
    <key>PYTHONDONTWRITEBYTECODE</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__LOG_DIRECTORY__/progress.stdout.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIRECTORY__/progress.stderr.log</string>
</dict>
</plist>
